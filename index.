<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NIDRA-AI | IVF Health Insights</title>
<style>
:root {
  --bg:#080d1c; --panel:#111a2e; --line:#283651;
  --text:#f4f7ff; --muted:#aab7ce;
  --cyan:#67e8f9; --purple:#a5b4fc;
}
* {box-sizing:border-box}
html {scroll-behavior:smooth}
body {
  margin:0;background:var(--bg);color:var(--text);
  font-family:Arial,sans-serif;line-height:1.6;
}
header {
  padding:18px 6%;display:flex;align-items:center;
  justify-content:space-between;gap:18px;flex-wrap:wrap;
  border-bottom:1px solid var(--line);position:sticky;top:0;
  background:#080d1cf2;z-index:10;
}
.logo {font-size:25px;font-weight:800;color:var(--purple)}
nav {display:flex;gap:17px;flex-wrap:wrap}
nav a {color:var(--text);text-decoration:none;font-size:14px}
a:hover {color:var(--cyan)}
main {max-width:1200px;margin:auto}
.hero {
  padding:70px 6%;background:
  radial-gradient(ellipse at 80% 15%,#333c7a88,transparent 48%);
}
.eyebrow {color:var(--cyan);letter-spacing:3px;font-size:12px}
h1 {font-size:clamp(38px,6vw,68px);line-height:1.1;margin:18px 0}
h1 span {color:var(--purple)}
h2 {font-size:29px;margin:0 0 10px}
h3 {margin-top:8px}
p {color:var(--muted)}
.hero p {max-width:700px;font-size:18px}
button,.button {
  border:0;border-radius:9px;padding:12px 18px;
  background:var(--purple);color:#080d1c;
  font-weight:bold;cursor:pointer;text-decoration:none;
  display:inline-block;
}
button:hover,.button:hover {filter:brightness(1.12)}
.secondary {background:transparent;border:1px solid var(--line);color:var(--text)}
section {padding:45px 6%}
.section-head {margin-bottom:22px}
.grid {display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:17px}
.card {
  padding:22px;border:1px solid var(--line);
  background:var(--panel);border-radius:15px;min-width:0;
}
.metric {font-size:29px;font-weight:bold;color:var(--cyan);overflow-wrap:anywhere}
.muted {color:var(--muted)}
.small {font-size:13px}
form {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}
.field {display:flex;flex-direction:column;gap:7px}
.field.full {grid-column:1/-1}
label {font-size:14px;color:#dbe5f6}
input,select,textarea {
  width:100%;padding:12px;border-radius:8px;
  border:1px solid #3a4966;background:#0b1325;
  color:var(--text);font:inherit;
}
input:focus,select:focus,textarea:focus {outline:2px solid var(--purple)}
.checks {display:flex;gap:14px;flex-wrap:wrap}
.checks label {display:flex;gap:7px;align-items:center}
.checks input {width:auto}
.notice {border-left:4px solid var(--cyan);padding:15px;background:#111a2e;border-radius:8px}
.result {margin-top:20px}
.status {font-weight:bold;color:var(--cyan)}
.status.warning {color:#fbbf24}
.status.urgent {color:#fca5a5}
.bar {height:8px;background:#283651;border-radius:9px;overflow:hidden;margin:10px 0}
.bar span {display:block;height:100%;width:0;background:var(--purple)}
ul {padding-left:22px;color:var(--muted)}
footer {padding:28px 6%;border-top:1px solid var(--line)}
[hidden] {display:none!important}
@media(max-width:620px) {
  header {position:static}
  form {grid-template-columns:1fr}
  .field.full {grid-column:auto}
  section {padding:32px 5%}
  .hero {padding:50px 5%}
}
</style>
</head>
<body>
<header>
  <div class="logo">✦ NIDRA-AI</div>
  <nav>
    <a href="#home">Home</a>
    <a href="#assessment">Health Form</a>
    <a href="#dashboard">Dashboard</a>
    <a href="#education">IVF Education</a>
    <a href="#about">About</a>
  </nav>
</header>

<main>
<section class="hero" id="home">
  <div class="eyebrow">AI + FERTILITY EDUCATION</div>
  <h1>Smarter Insights.<br><span>Safer IVF Journeys.</span></h1>
  <p>Explore your health measurements, understand general wellness indicators,
  and prepare informed questions for your fertility care team.</p>
  <a class="button" href="#assessment">Enter Health Details ↗</a>
  <a class="button secondary" href="#education">Explore IVF Education</a>
  <p class="small">Educational prototype — not a diagnostic or miscarriage-prediction tool.</p>
</section>

<section id="assessment">
  <div class="section-head">
    <div class="eyebrow">PATIENT INPUT</div>
    <h2>Health Check-In</h2>
    <p>Enter current measurements if available. Do not delay medical care to complete this form.</p>
  </div>

  <div class="card">
  <form id="healthForm">
    <div class="field">
      <label for="age">Age range</label>
      <select id="age">
        <option value="">Prefer not to say</option>
        <option>Under 25</option><option>25–34</option>
        <option>35–39</option><option>40 or older</option>
      </select>
    </div>
    <div class="field">
      <label for="stage">IVF stage</label>
      <select id="stage" required>
        <option value="">Choose stage</option>
        <option>Preparing for IVF</option><option>Before embryo transfer</option>
        <option>After embryo transfer</option><option>Pregnancy confirmed</option>
      </select>
    </div>
    <div class="field">
      <label for="temp">Body temperature (°C)</label>
      <input id="temp" type="number" min="30" max="45" step="0.1" placeholder="e.g. 36.8">
    </div>
    <div class="field">
      <label for="hr">Heart rate (beats/minute)</label>
      <input id="hr" type="number" min="20" max="250" step="1" placeholder="e.g. 78">
    </div>
    <div class="field">
      <label for="sleep">Sleep in the last 24 hours (hours)</label>
      <input id="sleep" type="number" min="0" max="24" step="0.5" placeholder="e.g. 7.5">
    </div>
    <div class="field">
      <label for="bp">Blood pressure (optional)</label>
      <input id="bp" type="text" placeholder="e.g. 120/80 mmHg">
    </div>
    <div class="field full">
      <label>Symptoms (select any that apply)</label>
      <div class="checks">
        <label><input type="checkbox" name="symptom" value="Fever or chills"> Fever or chills</label>
        <label><input type="checkbox" name="symptom" value="Abdominal pain"> Abdominal pain</label>
        <label><input type="checkbox" name="symptom" value="Bleeding"> Vaginal bleeding</label>
        <label><input type="checkbox" name="symptom" value="Dizziness"> Dizziness</label>
        <label><input type="checkbox" name="symptom" value="Breathing difficulty"> Breathing difficulty</label>
        <label><input type="checkbox" name="symptom" value="None selected"> None selected</label>
      </div>
      <p class="small">Select symptoms you are experiencing. This form does not diagnose their cause.</p>
    </div>
    <div class="field full">
      <label for="notes">Questions or other concerns (optional)</label>
      <textarea id="notes" rows="3" maxlength="500" placeholder="Write questions you want to discuss with your care team. Do not include identifying details."></textarea>
    </div>
    <div class="field full">
      <button type="submit">Review My Measurements</button>
      <p class="small">This demonstration processes entered data in your browser and does not send it to a server.</p>
    </div>
  </form>
  </div>
  <div id="formError" class="notice result" role="alert" hidden></div>
</section>

<section id="dashboard">
  <div class="section-head">
    <div class="eyebrow">YOUR READINGS</div>
    <h2>Health Dashboard</h2>
    <p>Submit the form to display your measurements here.</p>
  </div>
  <div class="grid">
    <article class="card">
      <div class="muted">Body temperature</div>
      <div class="metric" id="outTemp">—</div>
      <div class="bar"><span id="barTemp"></span></div>
      <div id="statusTemp" class="small muted">No reading entered</div>
    </article>
    <article class="card">
      <div class="muted">Heart rate</div>
      <div class="metric" id="outHr">—</div>
      <div class="bar"><span id="barHr"></span></div>
      <div id="statusHr" class="small muted">No reading entered</div>
    </article>
    <article class="card">
      <div class="muted">Sleep duration</div>
      <div class="metric" id="outSleep">—</div>
      <div class="bar"><span id="barSleep"></span></div>
      <div id="statusSleep" class="small muted">No reading entered</div>
    </article>
    <article class="card">
      <div class="muted">Blood pressure</div>
      <div class="metric" id="outBp">—</div>
      <div id="statusBp" class="small muted">Optional reading</div>
    </article>
  </div>
  <div id="result" class="card result" hidden aria-live="polite">
    <h3>Measurement Summary</h3>
    <p id="summary"></p>
    <h3>Safety guidance</h3>
    <div id="guidance"></div>
    <p class="small">These are limited educational flags, not a comprehensive assessment. A reassuring reading does not rule out illness or pregnancy complications.</p>
    <button class="secondary" type="button" id="clearBtn">Clear entered data</button>
  </div>
</section>

<section id="education">
  <div class="eyebrow">LEARN & PREPARE</div>
  <h2>IVF Education Centre</h2>
  <div class="grid">
    <article class="card">
      <h3>🧬 Embryo development</h3>
      <p>Embryo chromosome differences can contribute to pregnancy loss. Not every loss has an identifiable cause.</p>
    </article>
    <article class="card">
      <h3>🌱 Implantation</h3>
      <p>Implantation involves an embryo attaching to the uterine lining. Outcomes vary even with appropriate care.</p>
    </article>
    <article class="card">
      <h3>🩺 Estrogen & progesterone</h3>
      <p>These hormones have roles in the uterine lining and pregnancy support. Follow your clinic's medication instructions.</p>
    </article>
    <article class="card">
      <h3>💤 Sleep & wellbeing</h3>
      <p>Tracking sleep may help you discuss wellbeing with your care team, but sleep duration alone cannot determine IVF success.</p>
    </article>
    <article class="card">
      <h3>📋 Questions for your doctor</h3>
      <p>Ask which measurements matter for your treatment, when to call the clinic, and how your medicines should be taken.</p>
    </article>
    <article class="card">
      <h3>🔬 AI research</h3>
      <p>Future research may investigate validated clinical data to support professionals. This prototype has no validated predictive model.</p>
    </article>
  </div>
</section>

<section id="about">
  <div class="eyebrow">ABOUT THE PROJECT</div>
  <h2>NIDRA-AI</h2>
  <p>NIDRA-AI explores how digital tools could support IVF education, wellness tracking, and informed conversations with fertility professionals.</p>
  <div class="notice">
    <strong>Medical safety notice</strong>
    <p>This is a student educational prototype, not a medical device. It cannot diagnose a condition, estimate individual miscarriage risk, or prevent pregnancy loss. Temperature, pulse, sleep, and blood pressure alone cannot determine whether a pregnancy is healthy. Never change prescribed medication based on this website.</p>
    <p>If you experience severe pain, heavy bleeding, fainting, or difficulty breathing, seek urgent medical care. Contact your fertility clinic promptly about fever or concerning symptoms.</p>
  </div>
</section>
</main>

<footer>
  <strong>NIDRA-AI</strong>
  <p class="small">Educational prototype · No clinical validation · No patient account or server storage</p>
</footer>

<script>
const form = document.getElementById("healthForm");
const errorBox = document.getElementById("formError");
const result = document.getElementById("result");

function reading(id, value, unit, status, percent, tone="") {
  document.getElementById(id).textContent = value == null ? "—" : value + unit;
  const base = id.replace("out", "");
  const bar = document.getElementById("bar" + base);
  const label = document.getElementById("status" + base);
  if (bar) bar.style.width = value == null ? "0%" : Math.max(4, Math.min(100, percent)) + "%";
  if (label) {
    label.textContent = status;
    label.className = "small " + (tone || "muted");
  }
}

function setStatus(id, text, tone="muted") {
  const el = document.getElementById(id);
  el.textContent = text;
  el.className = "small " + tone;
}

form.addEventListener("submit", function(event) {
  event.preventDefault();
  errorBox.hidden = true;

  const stage = document.getElementById("stage").value;
  const tempRaw = document.getElementById("temp").value;
  const hrRaw = document.getElementById("hr").value;
  const sleepRaw = document.getElementById("sleep").value;
  const bpRaw = document.getElementById("bp").value.trim();

  if (!stage) {
    errorBox.textContent = "Please select your IVF stage.";
    errorBox.hidden = false;
    return;
  }

  const temp = tempRaw === "" ? null : Number(tempRaw);
  const hr = hrRaw === "" ? null : Number(hrRaw);
  const sleep = sleepRaw === "" ? null : Number(sleepRaw);

  if ((temp !== null && (!Number.isFinite(temp) || temp < 30 || temp > 45)) ||
      (hr !== null && (!Number.isFinite(hr) || hr < 20 || hr > 250)) ||
      (sleep !== null && (!Number.isFinite(sleep) || sleep < 0 || sleep > 24))) {
    errorBox.textContent = "Please check your entries. Temperature must be 30–45 °C, heart rate 20–250 BPM, and sleep 0–24 hours. These are input limits, not safe health ranges.";
    errorBox.hidden = false;
    return;
  }

  const symptoms = [...document.querySelectorAll('input[name="symptom"]:checked')]
    .map(el => el.value).filter(v => v !== "None selected");
  const urgent = symptoms.includes("Breathing difficulty");
  const concerning = symptoms.some(v => ["Fever or chills","Abdominal pain","Bleeding","Dizziness"].includes(v));

  reading("outTemp", temp, " °C",
    temp == null ? "Not provided" :
    temp >= 38 ? "Fever-range reading: contact your clinic promptly" :
    temp >= 37.5 ? "Elevated: recheck and consider symptoms" :
    "No fever-range reading entered",
    temp == null ? 0 : temp / 40 * 100,
    temp >= 38 ? "warning" : "");
  reading("outHr", hr, " BPM",
    hr == null ? "Not provided" :
    hr < 50 || hr > 100 ? "Outside the usual adult resting reference range" :
    "Within the usual adult resting reference range",
    hr == null ? 0 : hr / 150 * 100,
    hr != null && (hr < 50 || hr > 100) ? "warning" : "");
  reading("outSleep", sleep, " h",
    sleep == null ? "Not provided" :
    sleep < 7 ? "Below the usual adult sleep recommendation" :
    sleep <= 9 ? "Within the usual adult sleep recommendation" :
    "Above the usual adult sleep recommendation",
    sleep == null ? 0 : sleep / 10 * 100);
  document.getElementById("outBp").textContent = bpRaw || "—";
  setStatus("statusBp", bpRaw ? "Entered by patient; not clinically interpreted" : "Not provided");

  const notes = [];
  if (temp != null && temp >= 38) notes.push("Your temperature is in a fever range. Contact your fertility clinic promptly, especially if you are pregnant or recently had a procedure.");
  if (hr != null && (hr < 50 || hr > 100)) notes.push("Your heart rate is outside a common adult resting reference range. Activity, stress, medicines and other factors affect pulse; repeat at rest and seek clinician advice if persistent or concerning.");
  if (sleep != null && sleep < 7) notes.push("Your reported sleep is below the usual recommendation for many adults. Consider discussing persistent sleep problems with a healthcare professional.");
  if (urgent) notes.push("You selected difficulty breathing. Seek urgent medical care now.");
  if (symptoms.includes("Bleeding")) notes.push("Contact your fertility clinic for guidance about bleeding during IVF or pregnancy. Heavy bleeding, fainting or severe pain requires urgent assessment.");
  if (symptoms.includes("Abdominal pain")) notes.push("Contact your clinic about abdominal pain. Severe pain, particularly with dizziness or fainting, needs urgent medical assessment.");
  if (symptoms.includes("Dizziness")) notes.push("If dizziness is severe, recurrent, or accompanied by fainting, pain or bleeding, seek urgent medical assessment.");
  if (symptoms.includes("Fever or chills") && (temp == null || temp < 38)) notes.push("You selected fever or chills. A single temperature reading may not explain symptoms; contact your clinic promptly.");
  if (!notes.length) notes.push("No listed warning symptom or selected temperature flag was detected from the information entered. This does not establish that you are medically well or that an IVF outcome is assured.");

  document.getElementById("summary").textContent =
    "IVF stage: " + stage + ". Only the measurements you entered are summarized. These indicators do not assess miscarriage risk.";
  const guidance = document.getElementById("guidance");
  guidance.replaceChildren();
  notes.forEach(note => {
    const p = document.createElement("p");
    p.textContent = "• " + note;
    guidance.appendChild(p);
  });
  if (urgent) guidance.className = "status urgent";
  else if (concerning || (temp != null && temp >= 38)) guidance.className = "status warning";
  else guidance.className = "muted";

  result.hidden = false;
  result.scrollIntoView({behavior:"smooth", block:"start"});
});

document.getElementById("clearBtn").addEventListener("click", () => {
  form.reset();
  result.hidden = true;
  errorBox.hidden = true;
  ["outTemp","outHr","outSleep","outBp"].forEach(id => document.getElementById(id).textContent = "—");
  ["barTemp","barHr","barSleep"].forEach(id => document.getElementById(id).style.width = "0%");
  ["statusTemp","statusHr","statusSleep"].forEach(id => {
    document.getElementById(id).textContent = "No reading entered";
    document.getElementById(id).className = "small muted";
  });
  setStatus("statusBp","Optional reading");
});
</script>
</body>
</html>
